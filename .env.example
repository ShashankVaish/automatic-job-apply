# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Any Gemini model id. Flash is cheap/fast and plenty for this job.
GEMINI_MODEL=gemini-2.5-flash

# Gmail API, for cold email outreach. Download credentials.json from the
# Google Cloud Console (see "Gmail setup" in README.md). The token is written
# after a one-time browser consent. Your Gmail password is never used.
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Optional email finder for outreach. Off unless outreach.use_hunter is true
# in config.yaml. Only results with confidence >= 85 are ever used.
HUNTER_API_KEY=
