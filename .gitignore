# ---- secrets: never commit ----
.env
credentials.json
token.json
*token.json

# ---- personal config: only the example is committed ----
config.yaml

# ---- browser profiles (contain live login sessions) ----
browser_profile/
chrome_bot_profile/

# ---- your own documents and data ----
resumes/*.pdf
resumes/*.doc
resumes/*.docx
data/*.db
data/*.db-journal
logs/
screenshots/
drafts/
outbox/
applications.csv
followups.csv

# ---- run inputs: only the .example files are committed ----
inputs/*.txt
inputs/*.csv
!inputs/*.example.txt
!inputs/*.example.csv

# ---- python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- outreach inputs and drafts ----
inputs/companies.csv
inputs/job_urls.txt
